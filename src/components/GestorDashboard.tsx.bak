import React, { useState, useEffect } from 'react';
import { usePlatform } from '../context/PlatformContext';
import { getGestorKpis, getActiveOrganizationId, getActiveOrganizationDetails, getGestorComunicados, createAnnouncement } from '../lib/gestor/queries';
import { Building2, GraduationCap, Users, BookOpen, Bell, Calendar, Plus, Loader2 } from 'lucide-react';

export function GestorDashboard() {
  const { currentUser } = usePlatform();
  const [kpis, setKpis] = useState<any>(null);
  const [orgDetails, setOrgDetails] = useState<any>(null);
  const [announcements, setAnnouncements] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [debugInfo, setDebugInfo] = useState<string>('');
  
  const [newTitle, setNewTitle] = useState('');
  const [newBody, setNewBody] = useState('');
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [formError, setFormError] = useState('');
  const [successMsg, setSuccessMsg] = useState('');

  const loadData = async () => {
    setLoading(true);
    let orgId = currentUser?.organizationId;
    
    if (!orgId && currentUser?.id) {
      orgId = await getActiveOrganizationId(currentUser.id);
      setDebugInfo(`Resolved orgId from members: ${orgId}`);
    } else {
      setDebugInfo(`Using orgId from context: ${orgId}`);
    }

    if (orgId) {
      const [kpisData, orgData, announcementsData] = await Promise.all([
        getGestorKpis(orgId),
        getActiveOrganizationDetails(orgId),
        getGestorComunicados(orgId)
      ]);
      setKpis(kpisData);
      setOrgDetails(orgData);
      setAnnouncements(announcementsData);
      setDebugInfo(prev => `${prev} | KPIs: ${JSON.stringify(kpisData)} | Org: ${JSON.stringify(orgData)}`);
    } else {
      setDebugInfo(prev => `${prev} | OrgId not found`);
    }
    setLoading(false);
  };

  useEffect(() => {
    loadData();
  }, [currentUser]);

  const handleCreateAnnouncement = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormError('');
    setSuccessMsg('');
    if (!newTitle.trim() || !newBody.trim()) {
      setFormError('Título e corpo são obrigatórios');
      return;
    }
    
    let orgId = currentUser?.organizationId;
    if (!orgId && currentUser?.id) {
      orgId = await getActiveOrganizationId(currentUser.id);
    }
    
    if (!orgId || !currentUser?.id) {
      setFormError('Erro ao identificar organização ou usuário ativo.');
      return;
    }

    setIsSubmitting(true);
    try {
      await createAnnouncement(orgId, currentUser.id, newTitle, newBody);
      setNewTitle('');
      setNewBody('');
      setSuccessMsg('Comunicado publicado com sucesso!');
      await loadData();
    } catch (err: any) {
      setFormError(err.message || 'Erro ao criar comunicado');
    } finally {
      setIsSubmitting(false);
    }
  };

  if (loading) return <div className="p-8 text-white">Carregando painel gestor...</div>;

  const orgLabel = orgDetails?.trade_name || orgDetails?.legal_name || orgDetails?.id || 'Não informada';

  return (
    <div className="p-6 space-y-6">
      <div className="flex items-center justify-between">
        <h1 className="text-2xl font-bold text-white">Painel do Gestor</h1>
        <div className="text-sm text-gold">Visão Administrativa</div>
      </div>
      
      {debugInfo && <div className="text-xs text-slate-500 bg-slate-950 p-2 rounded">DEBUG: {debugInfo}</div>}

      <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
        <MetricCard title="Alunos" value={kpis?.totalAlunos || 0} icon={Users} />
        <MetricCard title="Professores" value={kpis?.totalProfessores || 0} icon={GraduationCap} />
        <MetricCard title="Turmas" value={kpis?.totalTurmas || 0} icon={Building2} />
        <MetricCard title="Comunicados" value={kpis?.comunicados || 0} icon={Bell} />
      </div>

      <div className="bg-slate-900 rounded-xl p-6 border border-slate-800">
        <h2 className="text-lg font-bold text-white mb-4">Bem-vindo, {currentUser?.name || 'Gestor'}</h2>
        <p className="text-slate-400">Você está acessando os dados da organização: {orgLabel}.</p>
      </div>

      <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div className="bg-slate-900 rounded-xl p-6 border border-slate-800">
          <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <Plus className="w-5 h-5 text-gold" />
            Novo Comunicado
          </h3>
          <form onSubmit={handleCreateAnnouncement} className="space-y-4">
            {formError && <div className="text-red-400 text-sm">{formError}</div>}
            {successMsg && <div className="text-emerald-400 text-sm">{successMsg}</div>}
            <div>
              <label className="block text-sm text-slate-400 mb-1">Título</label>
              <input
                type="text"
                value={newTitle}
                onChange={e => setNewTitle(e.target.value)}
                className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white outline-none focus:border-gold"
                placeholder="Título do comunicado..."
              />
            </div>
            <div>
              <label className="block text-sm text-slate-400 mb-1">Mensagem</label>
              <textarea
                value={newBody}
                onChange={e => setNewBody(e.target.value)}
                className="w-full bg-slate-950 border border-slate-800 rounded-lg p-2 text-white outline-none focus:border-gold min-h-[100px]"
                placeholder="Corpo do comunicado..."
              />
            </div>
            <button
              type="submit"
              disabled={isSubmitting}
              className="px-4 py-2 bg-gold text-slate-950 font-medium rounded-lg hover:bg-yellow-500 disabled:opacity-50 flex items-center gap-2"
            >
              {isSubmitting ? <Loader2 className="w-4 h-4 animate-spin" /> : 'Publicar Comunicado'}
            </button>
          </form>
        </div>

        <div className="bg-slate-900 rounded-xl p-6 border border-slate-800">
          <h3 className="text-lg font-bold text-white mb-4 flex items-center gap-2">
            <Bell className="w-5 h-5 text-gold" />
            Comunicados Recentes
          </h3>
          <div className="space-y-4 max-h-[300px] overflow-y-auto pr-2 custom-scrollbar">
            {announcements.length === 0 ? (
              <div className="text-slate-400 text-sm">Nenhum registro encontrado.</div>
            ) : (
              announcements.map(ann => (
                <div key={ann.id} className="p-4 bg-slate-950 rounded-lg border border-slate-800">
                  <div className="text-xs text-gold mb-1">
                    {new Date(ann.published_at).toLocaleDateString('pt-BR')}
                  </div>
                  <h4 className="font-bold text-white mb-2">{ann.title}</h4>
                  <p className="text-sm text-slate-400 whitespace-pre-wrap">{ann.body}</p>
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </div>
  );
}

function MetricCard({ title, value, icon: Icon }: any) {
  return (
    <div className="bg-slate-900 border border-slate-800 p-4 rounded-xl flex items-center gap-4">
      <div className="p-2 bg-gold/10 rounded-lg text-gold">
        <Icon className="w-6 h-6" />
      </div>
      <div>
        <div className="text-xs text-slate-400">{title}</div>
        <div className="text-xl font-bold text-white">{value}</div>
      </div>
    </div>
  );
}
