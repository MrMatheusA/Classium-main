import React, { useState, useMemo, useEffect, useRef } from 'react';
import { supabase } from '../../lib/supabase';
import { 
  Building2, 
  Users, 
  ShieldCheck, 
  CreditCard, 
  TrendingUp, 
  CheckCircle2, 
  XCircle, 
  AlertTriangle, 
  Search, 
  Filter, 
